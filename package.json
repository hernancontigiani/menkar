{
  "name": "menkar",
  "version": "0.1.0",
  "private": true,
  "description": "A desktop app for working with several Claude Code sessions at once",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "main": "out/main/index.js",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "postinstall": "electron-rebuild -f -w node-pty",
    "dev": "node scripts/dev.mjs",
    "build": "electron-vite build",
    "rebuild-native": "electron-rebuild -f -w node-pty",
    "typecheck": "tsc -p tsconfig.core.json && tsc -p tsconfig.main.json && tsc -p tsconfig.renderer.json && tsc -p tsconfig.node.json",
    "lint": "biome ci .",
    "test": "vitest run",
    "check:code-rules": "node scripts/check-code-rules.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "ci": "node scripts/ci.mjs",
    "ui-check": "electron-vite build && xvfb-run -a env MENKAR_E2E_XVFB=1 playwright test",
    "package": "electron-vite build && electron-builder --linux deb --x64",
    "package:check": "node scripts/check-package.mjs",
    "package:smoke": "MENKAR_E2E_EXECUTABLE=release/linux-unpacked/menkar xvfb-run -a env MENKAR_E2E_XVFB=1 playwright test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-css": "6.3.1",
    "@codemirror/lang-html": "6.4.12",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@electron/rebuild": "4.2.1",
    "@playwright/test": "1.65.0",
    "@types/markdown-it": "14.2.0",
    "@types/node": "22.20.5",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-search": "0.16.0",
    "@xterm/xterm": "6.0.0",
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "markdown-it": "15.0.3",
    "typescript": "6.0.3",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "@xterm/headless": "6.0.0",
    "node-pty": "1.1.0"
  },
  "author": {
    "name": "Hernan Contigiani",
    "email": "hernan4790@gmail.com"
  },
  "homepage": "https://github.com/hernancontigiani/menkar",
  "desktopName": "menkar.desktop"
}
